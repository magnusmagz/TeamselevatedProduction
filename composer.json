{
    "name": "teamselevated/backend",
    "description": "Teams Elevated Backend",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "phpmailer/phpmailer": "^6.9",
        "predis/predis": "^2.0",
        "stripe/stripe-php": "^20.3",
        "minishlink/web-push": "^11.0",
        "guzzlehttp/guzzle": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TeamsElevated\\": "src/"
        },
        "classmap": [
            "services/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TeamsElevated\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "vendor-dir": "vendor"
    }
}
