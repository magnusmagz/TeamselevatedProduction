-- ============================================
-- DEMO PAYMENT DATA SEED SCRIPT
-- Teams Elevated - Revenue Collection Demo
-- ============================================
-- This script generates realistic demo data for showcasing
-- the payment collection and reporting system
-- ============================================

-- IMPORTANT: Run this AFTER the payment schema migration
-- This assumes leagues, clubs, and users already exist

BEGIN;

-- ============================================
-- 1. CLEAR EXISTING PAYMENT DATA (Demo Only!)
-- ============================================
TRUNCATE TABLE payment_transactions CASCADE;
TRUNCATE TABLE payment_installments CASCADE;
TRUNCATE TABLE athlete_payments CASCADE;
TRUNCATE TABLE scholarship_applications CASCADE;
TRUNCATE TABLE scholarships CASCADE;
TRUNCATE TABLE discount_codes CASCADE;
TRUNCATE TABLE payment_items CASCADE;
TRUNCATE TABLE payment_plans CASCADE;

-- Keep programs but clear payment-related data
-- DELETE FROM programs WHERE name LIKE '%Demo%'; -- Optional

-- ============================================
-- 2. CREATE DEMO PROGRAMS
-- ============================================
-- Assuming league_id = 1 and club_id = 1 exist (adjust as needed)

INSERT INTO programs (name, description, league_id, club_id, season_type, age_min, age_max, skill_level, start_date, end_date, capacity, gender, active, status)
VALUES
    ('Fall Soccer - U10', 'Recreational soccer program for ages 8-10', 1, 1, 'Fall', 8, 10, 'Beginner', '2024-09-01', '2024-11-30', 30, 'Mixed', true, 'active'),
    ('Fall Soccer - U12', 'Competitive soccer program for ages 11-12', 1, 1, 'Fall', 11, 12, 'Intermediate', '2024-09-01', '2024-11-30', 25, 'Mixed', true, 'active'),
    ('Winter Basketball - U14', 'Indoor basketball league for ages 13-14', 1, 1, 'Winter', 13, 14, 'Intermediate', '2024-12-01', '2025-03-15', 28, 'Mixed', true, 'active'),
    ('Spring Baseball - U11', 'Youth baseball program for ages 10-11', 1, 1, 'Spring', 10, 11, 'Beginner', '2025-03-01', '2025-05-31', 32, 'Mixed', true, 'active'),
    ('Summer Camp - Multi-Sport', 'Week-long multi-sport summer camp', 1, 1, 'Summer', 6, 16, 'Beginner', '2025-06-15', '2025-06-19', 50, 'Mixed', true, 'active')
ON CONFLICT DO NOTHING;

