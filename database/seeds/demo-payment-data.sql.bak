    ('3-Month Payment Plan', 'Pay over 3 months with auto-pay', 3, 'monthly', 25.00, 1, 1, true, 10.00, 5, true),
    ('6-Month Payment Plan', 'Extended payment plan over 6 months', 6, 'monthly', 15.00, 1, 1, true, 10.00, 5, true),
    ('Seasonal Plan (4 months)', 'Pay over the season duration', 4, 'monthly', 20.00, 1, 1, true, 15.00, 3, true),
    ('Weekly Plan', 'Pay weekly over 8 weeks', 8, 'weekly', 10.00, 1, 1, true, 5.00, 2, true)
ON CONFLICT DO NOTHING;

-- ============================================
-- 4. CREATE PAYMENT ITEMS
-- ============================================
-- Get program IDs (assuming they were just inserted or exist)
DO $$
DECLARE
    prog_soccer_u10 INTEGER;
    prog_soccer_u12 INTEGER;
    prog_basketball INTEGER;
    prog_baseball INTEGER;
    prog_camp INTEGER;
BEGIN
    SELECT id INTO prog_soccer_u10 FROM programs WHERE name = 'Fall Soccer - U10' LIMIT 1;
    SELECT id INTO prog_soccer_u12 FROM programs WHERE name = 'Fall Soccer - U12' LIMIT 1;
    SELECT id INTO prog_basketball FROM programs WHERE name = 'Winter Basketball - U14' LIMIT 1;
    SELECT id INTO prog_baseball FROM programs WHERE name = 'Spring Baseball - U11' LIMIT 1;
    SELECT id INTO prog_camp FROM programs WHERE name = 'Summer Camp - Multi-Sport' LIMIT 1;

    -- Fall Soccer U10 Payment Items
