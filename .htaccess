# Heroku-compatible .htaccess
# Note: php_value directives are not supported on Heroku

RewriteEngine On

# Let PHP files handle OPTIONS requests for proper CORS headers
# DO NOT intercept OPTIONS at Apache level

# Route for athlete full profile
# Decision 14 (2026-09-02): document uploads are not durable (dyno disk) and were served with
# no login. Refuse the folder until durable, authorised storage ships (roadmap Phase 5).
RewriteRule ^uploads/club-documents/ - [F,L]

RewriteRule ^api/athletes/([0-9]+)/full-profile$ api/athletes-profile.php/$1 [L]

# Email/SMS API routes
RewriteRule ^api/communications api/communications-gateway.php [QSA,L]
RewriteRule ^api/recipient-search api/recipient-search-gateway.php [QSA,L]
RewriteRule ^api/analytics api/analytics-gateway.php [QSA,L]
RewriteRule ^api/email-templates$ api/email-templates.php [QSA,L]

# Tracking routes (no auth)
RewriteRule ^api/track/pixel/([a-f0-9]+)\.gif$ api/track/pixel.php?trackingId=$1 [QSA,L]
RewriteRule ^api/track/click/([a-f0-9]+)/([a-f0-9]+)$ api/track/click.php?trackingId=$1&linkId=$2 [QSA,L]

# Webhook routes (no auth)
RewriteRule ^api/webhooks/sendgrid api/webhooks/sendgrid.php [QSA,L]
RewriteRule ^api/webhooks/twilio-status api/webhooks/twilio-status.php [QSA,L]

# Unsubscribe landing page
RewriteRule ^unsubscribe api/communications-gateway.php?action=unsubscribe [QSA,L]

# Canva Connect OAuth redirect. The path is registered in the Canva Developer
# Portal and sent again during the token exchange, where it must match
# byte-for-byte — so it is rewritten here rather than renamed to suit the file.
RewriteRule ^api/oauth/canva/callback$ api/oauth/canva-callback.php [QSA,L]

# Default fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
